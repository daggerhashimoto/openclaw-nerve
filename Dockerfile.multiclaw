FROM node:22-bookworm-slim AS build

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build && npm run build:server && npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates bash git \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g openclaw

COPY --from=build /app/dist ./dist
COPY --from=build /app/server-dist ./server-dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY scripts/start-multiclaw.sh /usr/local/bin/start-multiclaw.sh

RUN chmod +x /usr/local/bin/start-multiclaw.sh

USER node

EXPOSE 3080 3181

ENTRYPOINT ["/usr/local/bin/start-multiclaw.sh"]
